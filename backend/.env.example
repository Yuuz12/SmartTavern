# SmartTavern 后端环境变量配置

# 服务配置
PORT=3000
NODE_ENV=development

# JWT 密钥（生产环境务必修改）
JWT_SECRET=smarttavern_default_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 数据存储路径
DATA_PATH=./data
UPLOAD_PATH=./uploads
BACKUP_PATH=./backups

# CORS 配置（前后端同源）
CORS_ORIGIN=http://localhost:3000

# 文件上传限制
MAX_FILE_SIZE=2097152

# 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# 日志级别
LOG_LEVEL=info
